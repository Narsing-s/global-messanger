# Copy to deploy/.env before starting the self-hosted stack.
# Generate secrets with: openssl rand -hex 32

POSTGRES_DB=global_messenger
POSTGRES_USER=global_messenger
POSTGRES_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-a-long-random-secret

# Public HTTP endpoint. Put your own DNS name here when available.
PUBLIC_HOST=localhost
WEB_ORIGIN=http://localhost
PASSWORD_RESET_WEB_ORIGIN=http://localhost
HTTP_PORT=80

# Web build uses same-origin /api and /socket.io when empty.
API_URL=

# Calling. MEDIASOUP_ANNOUNCED_IP must be the server's public IP for internet calls.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
TURN_REALM=global-messenger
TURN_USERNAME=global-messenger
TURN_CREDENTIAL=replace-with-a-random-turn-secret
TURN_URL=turn:localhost:3478
TURN_REQUIRED=false

# Email is optional for core username/password messaging.
# Configure your own SMTP server here if password-reset email is required.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Global Messenger <no-reply@localhost>

# Optional deployment metadata.
APP_VERSION=self-hosted
GIT_COMMIT=local
REGION_ID=self-hosted
REGIONS=self-hosted
