{
  "name": "global-messenger",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "predev": "node scripts/harden-app.mjs && node scripts/fix-chat-switch.mjs && node scripts/fix-unread.mjs && node scripts/error-boundary.mjs",
    "prebuild": "node scripts/harden-app.mjs && node scripts/fix-chat-switch.mjs && node scripts/fix-unread.mjs && node scripts/error-boundary.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:server:direct": "npm --prefix apps/server run dev",
    "dev:web:direct": "npm --prefix apps/web run dev -- --host 127.0.0.1 --strictPort",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "db:generate": "npm run db:generate -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server",
    "android:add": "npm run android:add -w apps/web",
    "android:sync": "npm run android:sync -w apps/web",
    "android:open": "npm run android:open -w apps/web",
    "android:run": "npm run android:run -w apps/web",
    "db:deploy": "prisma migrate deploy --schema apps/server/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util@1.15.3": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "prisma@6.3.1": true,
    "protobufjs@7.6.6": true
  }
}
