{
  "name": "global-messenger",
  "private": true,
  "version": "0.1.0",
  "description": "Serverless peer-to-peer messenger with device-owned local data",
  "workspaces": [
    "apps/web",
    "apps/cloudflare"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w apps/web -- --host 127.0.0.1 --strictPort",
    "dev:web:direct": "npm run dev -w apps/web -- --host 127.0.0.1 --strictPort",
    "build": "npm run build -w apps/web",
    "build:web": "npm run build -w apps/web",
    "verify:operations": "npm run validate:operations -w apps/web",
    "e2e:release": "npm run e2e:release -w apps/web",
    "e2e:remainder": "npm run e2e:remainder -w apps/web",
    "verify:local": "node scripts/local-verify.mjs",
    "smoke": "node scripts/local-smoke.mjs",
    "d1:local": "npm run db:local -w apps/cloudflare",
    "d1:deploy": "npm run db:remote -w apps/cloudflare",
    "android:add": "npm run android:add -w apps/web",
    "android:sync": "npm run android:sync -w apps/web",
    "android:open": "npm run android:open -w apps/web",
    "android:run": "npm run android:run -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util@1.15.3": true,
    "protobufjs": true
  }
}
