# Global Messenger — Supabase target configuration
# Do not commit real values. Worker-only secrets:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_never_expose
# Keep until the D1 -> Supabase application cutover is fully verified.
JWT_SECRET=replace_with_a_long_random_secret

# Web client values (only after Supabase Auth adapter is enabled)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
