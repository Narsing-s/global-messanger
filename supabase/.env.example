# Global Messenger — Supabase target configuration
# Do not commit real values. Worker-only secrets:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_never_expose
# Keep until the D1 -> Supabase application cutover is fully verified.
JWT_SECRET=replace_with_a_long_random_secret

# Web client values for Vercel and local Vite builds. The publishable key is safe for browsers;
# never put SUPABASE_SERVICE_ROLE_KEY in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy alternative accepted by the app:
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
