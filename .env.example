# Docker Compose
POSTGRES_DB=global_messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET=change-this-to-a-long-random-production-secret
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
PASSWORD_RESET_WEB_ORIGIN=http://localhost:8080

# Production SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Global Messenger <no-reply@example.com>

# P2 Calling / SFU / TURN
SFU_PROVIDER=mediasoup
SFU_SIGNALING_URL=
TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REQUIRED=false
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999

# P4 AI / transcription (never point these at private E2EE plaintext without explicit user consent)
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
AI_PROVIDER_URL=

# P5 malware / region / CDN / disaster recovery
CLAMDSCAN_PATH=clamdscan
REGION_ID=primary
REGIONS=primary
READ_REPLICA_DATABASE_URL=
CDN_ORIGIN=
PG_WAL_ARCHIVE_BUCKET=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET_COMMAND=
