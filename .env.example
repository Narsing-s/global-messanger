# Docker Compose — SQLite only
SQLITE_DB_PATH=/data/global-messenger.db
JWT_SECRET=change-this-to-a-long-random-production-secret
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
PASSWORD_RESET_WEB_ORIGIN=http://localhost:8080

# Production SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Global Messenger <no-reply@example.com>

# P2 Calling / SFU / TURN
SFU_PROVIDER=mediasoup
SFU_SIGNALING_URL=
TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REQUIRED=false
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999

# P4 AI / transcription
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
WHISPER_CPP_PATH=
WHISPER_MODEL_PATH=
AI_PROVIDER_URL=

# P5 media / backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
