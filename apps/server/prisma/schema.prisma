generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String?              @unique
  phoneNumber         String?              @unique
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  displayName         String
  passwordHash        String
  avatarUrl           String?
  lastSeenAt          DateTime             @default(now())
  privacyLastSeen     String               @default("everyone")
  privacyProfilePhoto String               @default("everyone")
  e2eePublicKey       String?
  e2eeKeyVersion      Int                  @default(1)
  role                String               @default("USER")
  createdAt            DateTime             @default(now())
  messages            Message[]
  memberships         ConversationMember[]
  createdConvos       Conversation[]       @relation("ConversationCreator")
  reactions           MessageReaction[]
  devices             PushDevice[]
  sessions             UserSession[]
  bookmarks           MessageBookmark[]
  pinsCreated         PinnedMessage[]      @relation("PinCreator")
  blocksCreated       UserBlock[]          @relation("BlockCreator")
  blockedBy            UserBlock[]          @relation("BlockedUser")
  messageReceipts     MessageReceipt[]
  supportResolutions  SupportResolution[]  @relation("SupportResolver")
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  deviceName String?
  platform   String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model PushDevice {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  platform    String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, enabled])
}

model Conversation {
  id          String               @id @default(cuid())
  title       String?
  isGroup     Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  creatorId   String?
  creator     User?                @relation("ConversationCreator", fields: [creatorId], references: [id])
  members     ConversationMember[]
  messages    Message[]
  pins        PinnedMessage[]
  @@index([updatedAt])
}