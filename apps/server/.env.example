# Local development defaults
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/global_messenger"
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-local-secret"

# Optional password-reset email (leave empty for local-only development)
RESEND_API_KEY=""
MAIL_FROM="Global Messenger <no-reply@localhost>"
PASSWORD_RESET_WEB_ORIGIN="http://127.0.0.1:5173"

# Production must use real secrets and HTTPS. Never commit .env.
