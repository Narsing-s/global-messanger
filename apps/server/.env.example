# Global Messenger server environment — SQLite only
DATABASE_URL="file:/data/global-messenger.db"
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-local-secret"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Global Messenger <no-reply@example.com>"
APP_WEB_ORIGIN="http://127.0.0.1:5173"
PASSWORD_RESET_WEB_ORIGIN="http://127.0.0.1:5173"

# Persistent SQLite database and uploads when self-hosted with Docker
SQLITE_DB_PATH="/data/global-messenger.db"
UPLOAD_DIR="/data/uploads"
