# Local development defaults
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/global_messenger"
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-local-secret"

# Password-reset mail uses the built-in SMTP client in Global Messenger.
# No Resend, SendGrid, Firebase, or email SDK/API is required.
SMTP_HOST="127.0.0.1"
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Global Messenger <no-reply@your-domain.example>"
PASSWORD_RESET_WEB_ORIGIN="http://127.0.0.1:5173"

# Production must use real secrets, a reachable SMTP server, and HTTPS.
# Never commit .env.
