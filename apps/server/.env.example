# Global Messenger server environment
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/global_messenger"
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-local-secret"

# Real email delivery: send Global Messenger emails from narsingbeesetti22@gmail.com
# Gmail requires an App Password for SMTP authentication. Never put your normal
# Gmail password or the App Password into GitHub.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER="narsingbeesetti22@gmail.com"
SMTP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
MAIL_FROM="Global Messenger <narsingbeesetti22@gmail.com>"
APP_WEB_ORIGIN="http://127.0.0.1:5173"
PASSWORD_RESET_WEB_ORIGIN="http://127.0.0.1:5173"

# For local-only Mailpit testing, use instead:
# SMTP_HOST="127.0.0.1"
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_STARTTLS=false
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Global Messenger <narsingbeesetti22@gmail.com>"
# Mailpit captures mail locally; it does not deliver to real inboxes.

# Never commit apps/server/.env.
