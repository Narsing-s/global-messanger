{
  "name": "global-messenger-web",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "validate:operations": "npm run apply:product-patches && node scripts/validate-operations.mjs",
    "e2e:release": "npm run apply:product-patches && node scripts/release-e2e.mjs",
    "e2e:remainder": "npm run apply:product-patches && node scripts/remainder-e2e.mjs",
    "e2e:browser": "npm run apply:product-patches && node scripts/browser-e2e.mjs",
    "android:add": "cap add android",
    "android:sync": "cap sync",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "mobile:sync": "cap sync",
    "validate": "tsc -b",
    "e2e": "vite build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/push-notifications": "^7.4.0",
    "lucide-react": "^0.511.0",
    "mediasoup-client": "^3.23.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.0",
    "@rollup/rollup-linux-x64-musl": "4.63.0"
  }
}
